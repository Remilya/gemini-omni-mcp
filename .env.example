# ==============================================================================
# gemini-omni-mcp Environment Configuration
# Copy to `.env` in your workspace (or pass via your MCP client's `env` block).
# ==============================================================================

# Required (unless using Vertex AI below)
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=                     # Optional alias (takes priority if both are set)

# Real-Time USD Spend Guard / Hard-Stop Kill-Switch
# Automatically locks API calls if cumulative ledger spend reaches this limit.
# Set to 0 to disable the hard stop.
OMNI_HARD_STOP_LIMIT_USD=50.0

# Optional Workspace & Ledger Paths
# GEMINI_OMNI_WORKSPACE=              # Defaults to current working directory
# GEMINI_OMNI_LEDGER_PATH=            # Defaults to <workspace>/.gemini-omni/usage_ledger.json

# Optional Feature Flags
# Set to false to disable the 3 optional 3D/CAD RLAIF tools (runs lean 9-tool mode)
GEMINI_OMNI_ENABLE_3D_TOOLS=true

# Optional Vertex AI Mode
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional Headless Blender Executable (only used by argon_judge_and_autopatch)
BLENDER_PATH=
