# ==============================================================================
# gemini-omni-mcp v3.0.0 Environment Configuration
# Copy to `.env` in your workspace (or pass via your MCP client's `env` block).
# ==============================================================================

# Required (unless using Vertex AI below; gemini_docs works without an API key)
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=                     # Optional alias (takes priority if both are set)

# Real-Time USD Spend Guard / Hard-Stop Kill-Switch
# Automatically locks API calls if cumulative ledger spend reaches this limit.
# Recommended: configure a hard Google Cloud / AI Studio billing cap as well.
# Set to 0 to disable the local ledger hard stop.
OMNI_HARD_STOP_LIMIT_USD=50.0

# Modular Toolset Filtering (comma-separated: core, swarm, research, 3d, all)
# Default: "core" (6 high-impact tools: image, video, audio, analyze, docs, budget)
GEMINI_OMNI_TOOLSETS=core

# Security Guardrails (strict defaults recommended)
# Allow read/write paths outside GEMINI_OMNI_WORKSPACE (default: false)
GEMINI_OMNI_ALLOW_OUTSIDE_WORKSPACE=false
# Allow arbitrary custom shell render_command in gemini_3d_judge_and_autopatch (default: false)
GEMINI_OMNI_ALLOW_CUSTOM_RENDER_CMD=false

# Optional Workspace & Ledger Paths
# GEMINI_OMNI_WORKSPACE=              # Defaults to current working directory
# GEMINI_OMNI_LEDGER_PATH=            # Defaults to <workspace>/.gemini-omni/usage_ledger.json

# Legacy Feature Flag (superseded by GEMINI_OMNI_TOOLSETS; kept for backwards compatibility)
# GEMINI_OMNI_ENABLE_3D_TOOLS=false

# Optional Vertex AI Mode
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional Headless Blender Executable (only used by gemini_3d_judge_and_autopatch in `3d` toolset)
BLENDER_PATH=
